{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "@HOOK@ codex start", "timeout": 30}]}
    ],
    "PreToolUse": [
      {"matcher": "^mcp__hub.*__hub_", "hooks": [{"type": "command", "command": "@HOOK@ codex pre", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "^mcp__hub.*__hub_subscribe$", "hooks": [{"type": "command", "command": "@HOOK@ codex post", "timeout": 30}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "@HOOK@ codex stop", "timeout": 30}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "@HOOK@ codex end", "timeout": 20}]}
    ]
  }
}
